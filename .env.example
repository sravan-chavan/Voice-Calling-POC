# Plivo authentication (required)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Caller ID — must be a Plivo number on your account (required)
PLIVO_FROM_NUMBER=

# URL Plivo fetches when the call is answered (required)
# Demo XML: https://s3.amazonaws.com/static.plivo.com/answer.xml
PLIVO_ANSWER_URL=

# Optional: HTTP method used to fetch AnswerURL (default: GET)
# PLIVO_ANSWER_METHOD=GET

# Optional: destination for one-shot CLI mode (or pass -to flag)
# CALL_TO=

# Optional: enable HTTP server mode (e.g. :8080). Used by Docker/Kubernetes.
# HTTP_ADDR=
